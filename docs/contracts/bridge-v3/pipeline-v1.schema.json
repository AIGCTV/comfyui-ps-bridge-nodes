{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "urn:vplugins:bridge-v3:pipeline:1",
  "$defs": {
    "capabilities": {
      "type": "object",
      "required": ["version", "serverEpoch", "schemaSha256", "capabilities"],
      "properties": {
        "version": {"const": 1},
        "serverEpoch": {"type": "string", "minLength": 1},
        "schemaSha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
        "capabilities": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}
      },
      "additionalProperties": false
    },
    "observer": {
      "type": "object",
      "required": ["version", "serverEpoch", "runId", "nativeClientId", "ready"],
      "properties": {
        "version": {"const": 1}, "serverEpoch": {"type": "string", "minLength": 1},
        "runId": {"type": "string", "minLength": 1}, "nativeClientId": {"type": "string", "minLength": 1},
        "ready": {"const": true}
      },
      "additionalProperties": false
    },
    "event": {
      "type": "object",
      "required": ["version", "serverEpoch", "scope", "runId", "promptId", "runOrder", "sequence", "kind", "payload"],
      "properties": {
        "version": {"const": 1}, "serverEpoch": {"type": "string", "minLength": 1},
        "scope": {"type": "object"}, "runId": {"type": "string", "minLength": 1},
        "promptId": {"type": ["string", "null"], "minLength": 1},
        "runOrder": {"type": "integer", "minimum": 1, "maximum": 9007199254740991},
        "sequence": {"type": "integer", "minimum": 0, "maximum": 9007199254740991},
        "kind": {"enum": ["snapshot", "input.ready", "execution.started", "node.executing", "execution.cached", "node.output", "progress", "result.ready", "execution.succeeded", "execution.failed", "execution.interrupted"]},
        "payload": {"type": "object"}
      },
      "additionalProperties": false
    },
    "submissionRejected": {
      "type": "object", "required": ["version", "runId", "claimToken", "httpStatus", "error", "nodeErrors"],
      "properties": {
        "version": {"const": 1}, "runId": {"type": "string", "minLength": 1},
        "claimToken": {"type": "string", "minLength": 1}, "httpStatus": {"const": 400},
        "error": {"type": "object", "required": ["code", "message", "retryable"],
          "properties": {"code": {"const": "PROMPT_REJECTED"}, "message": {"type": "string", "maxLength": 4096}, "retryable": {"const": false}}, "additionalProperties": false},
        "nodeErrors": {"type": "array", "maxItems": 64, "items": {
          "type": "object", "required": ["nodeId", "nodeType", "errors"],
          "properties": {
            "nodeId": {"type": "string", "maxLength": 256}, "nodeType": {"type": "string", "maxLength": 256},
            "errors": {"type": "array", "maxItems": 16, "items": {
              "type": "object", "required": ["code", "message"], "properties": {
                "code": {"type": "string", "maxLength": 128}, "message": {"type": "string", "maxLength": 512},
                "inputName": {"type": "string", "maxLength": 128}
              }, "additionalProperties": false
            }}
          }, "additionalProperties": false
        }}
      }, "additionalProperties": false
    }
  }
}
